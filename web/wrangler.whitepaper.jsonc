// whitepaper.imdusd.com: the INFER whitepaper, the same single file infer.miyagod.eth.limo serves from
// IPFS, served as a static asset by its own Worker. Stage and deploy with `npm run deploy:whitepaper`.
{
  "name": "whitepaper-imdusd",
  "compatibility_date": "2026-10-01",
  // The same tiny Worker as infer.imdusd.com: http -> https, then the assets.
  "main": "worker/infer.js",
  "assets": {
    "directory": "../dist-whitepaper",
    "binding": "ASSETS",
    // Static only: no file runs the Worker, so pages are served straight from Cloudflare's cache with no
    // request cap. HTTP -> HTTPS and www -> imdusd.com are the zone's "Always Use HTTPS" setting and a
    // Redirect Rule (set in the dashboard, 2026-10-08).
    "run_worker_first": false,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "whitepaper.imdusd.com", "custom_domain": true }]
}
