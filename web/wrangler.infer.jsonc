// infer.imdusd.com: the INFER token page (claim, swap, stake, tokenomics), served as static assets by
// its own Worker. It is a separate deployment from imdusd.com because, unlike the public site, it
// talks to a chain: its Content-Security-Policy admits the configured RPCs and claim-file origins.
// Build with `npm run build:infer`; deploy with `npm run deploy:infer`.
{
  "name": "infer-imdusd",
  "compatibility_date": "2026-10-01",
  "main": "worker/infer.js",
  "assets": {
    "directory": "../dist-infer",
    "binding": "ASSETS",
    // Only the two X player cards (X may frame them) and /rpc (worker/rpc.js) run the Worker. Every other file is
    // served straight from Cloudflare's cache: no Worker invocation, so no request cap. HTTP -> HTTPS is the
    // zone's "Always Use HTTPS" setting.
    "run_worker_first": ["/buy/*", "/97/*", "/rpc"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // No *.workers.dev copy: the site answers only on its own hostname, where the zone's HTTPS and redirect rules apply.
  "workers_dev": false,
  // Per-visitor limits on /rpc (worker/rpc.js), keyed by the connecting IP. A page polls every block and bundles its
  // reads, so a visitor with a few tabs open sends well under 100 requests a minute and far fewer cache misses.
  "ratelimits": [
    { "name": "RPC_REQUESTS", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RPC_UPSTREAM", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  // Busiest hour seen so far: 8.8 ms at p99. The cap bounds what one hostile request can cost.
  "limits": { "cpu_ms": 100 },
  "routes": [{ "pattern": "infer.imdusd.com", "custom_domain": true }]
}
