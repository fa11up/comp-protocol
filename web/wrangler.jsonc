// imdusd.com: the public site (homepage + docs), served as static assets by Cloudflare Workers.
// worker/index.js runs first only to redirect http:// to https://; every other request goes to the
// assets, where `_headers` and `_redirects` in dist-public/ apply as written.
// Build first with `npm run build:public`; deploy with `npm run deploy:public`.
{
  "name": "imdusd",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "../dist-public",
    "binding": "ASSETS",
    // So the http -> https redirect sees every request, including ones for files that exist.
    // Static only: no file runs the Worker, so pages are served straight from Cloudflare's cache with no
    // request cap. HTTP -> HTTPS and www -> imdusd.com are the zone's "Always Use HTTPS" setting and a
    // Redirect Rule (set in the dashboard, 2026-10-08).
    "run_worker_first": false,
    // /docs serves /docs/ and the site's relative links keep working.
    "html_handling": "auto-trailing-slash",
    // An unknown path is a 404 with the site's own not-found page (404.html, built from
    // src/NotFound.tsx), never the homepage pretending to be some other page.
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  // Cloudflare creates the DNS records and certificates for custom domains itself.
  "routes": [
    { "pattern": "imdusd.com", "custom_domain": true },
    { "pattern": "www.imdusd.com", "custom_domain": true }
  ]
}
